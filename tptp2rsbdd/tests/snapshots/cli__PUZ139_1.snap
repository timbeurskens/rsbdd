let beverage: type;
let syrup: type;
let coffee: beverage;
let vanilla_syrup: syrup;
let caramel_syrup: syrup;
let mixture: pi BeverageOrSyrup # (BeverageOrSyrup, syrup) -> BeverageOrSyrup;
let help_people_stay_awake: (beverage) -> bool;

(
    "mixture_of_coffee_help_people_stay_awake (tff, axiom)" (forall S: syrup # help_people_stay_awake(mixture(beverage, coffee, S)))
) => (
    "caramel_vanilla_coffee_help_people_stay_awake (tff, conjecture)" help_people_stay_awake(mixture(beverage, coffee, mixture(syrup, caramel_syrup, vanilla_syrup)))
)
