---
source: tests/cli.rs
expression: "run_formulas(&[\"true & false\", \"-(-a)\", \"a & -a\", \"a ^ a\", \"a nand a\",\n\"a nor a\", \"a <= b\", \"a <=> b\", \"if a then b else c\", \"[a, b] = 3\",\n\"[a, b] >= 0\", \"[a, b] < 0\", \"[a, b] > 2\", \"[a, a] = 1\", \"[a] = [b]\",\n\"[a, b] < [c]\", \"[a] > []\", \"exists z # a\", \"exists a, a # a & b\",\n\"forall a # a\", \"forall a # a | -a\", \"nu X # X & a\", \"mu X # X | a\",\n\"mu X # X\", \"nu X # X\", \"{undefined}\", \"\\\"only a comment\\\" a\",\n\"a and b or not c\",])"
---
$ rsbdd -t --evaluate=true & false
status: 20
--- stdout
| *     |
|-------|
| False |
--- stderr

$ rsbdd -t --evaluate=-(-a)
status: 10
--- stdout
| a     | *     |
|-------|-------|
| False | False |
| True  | True  |
--- stderr

$ rsbdd -t --evaluate=a & -a
status: 20
--- stdout
| a     | *     |
|-------|-------|
| Any   | False |
--- stderr

$ rsbdd -t --evaluate=a ^ a
status: 20
--- stdout
| a     | *     |
|-------|-------|
| Any   | False |
--- stderr

$ rsbdd -t --evaluate=a nand a
status: 10
--- stdout
| a     | *     |
|-------|-------|
| False | True  |
| True  | False |
--- stderr

$ rsbdd -t --evaluate=a nor a
status: 10
--- stdout
| a     | *     |
|-------|-------|
| False | True  |
| True  | False |
--- stderr

$ rsbdd -t --evaluate=a <= b
status: 10
--- stdout
| a     | b     | *     |
|-------|-------|-------|
| False | False | True  |
| False | True  | False |
| True  | Any   | True  |
--- stderr

$ rsbdd -t --evaluate=a <=> b
status: 10
--- stdout
| a     | b     | *     |
|-------|-------|-------|
| False | False | True  |
| False | True  | False |
| True  | False | False |
| True  | True  | True  |
--- stderr

$ rsbdd -t --evaluate=if a then b else c
status: 10
